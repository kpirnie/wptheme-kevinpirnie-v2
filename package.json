
{
    "name": "kevinpirnie-v2",
    "version": "1.0.0",
    "private": true,
    "description": "Kevin Pirnie V2 WordPress Theme",
    "scripts": {
        "build:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/theme.min.css --minify",
        "build:js": "node esbuild.config.js",
        "build": "npm run build:css && npm run build:js",
        "watch:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/theme.min.css --watch",
        "watch:js": "node esbuild.config.js --watch"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.1.0",
        "esbuild": "^0.27.0",
        "tailwindcss": "^4.1.0"
    }
}
